# LLM Coding Agent V4.1 ICS
# Copy to .env. Never commit the real .env.

# Workspace is optional. If omitted, the agent uses ../AGENT_WORKSPACE
# relative to the agent working directory and creates it when needed.
# Override only when you need another location.
# Windows example: AGENT_WORKSPACE_DIR=C:/script/AGENT_WORKSPACE
# AGENT_WORKSPACE_DIR=../AGENT_WORKSPACE

# Optional persistent state location (history, incidents, task state, logs).
# If omitted: ~/.llm_agent_v4
# AGENT_STATE_DIR=C:/script/.llm_agent_v4_state

# Optional alternative configuration directory / env file.
# AGENT_CONFIG_DIR=
# AGENT_ENV_FILE=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434

# Preferred: precomputed Base64 authorization key from GigaChat credentials.
GIGACHAT_AUTH_KEY=
# Alternative: agent computes Base64(client_id:client_secret).
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Optional custom CA bundle if your environment requires it.
GIGACHAT_CA_BUNDLE=

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Optional endpoint override. Leave empty/unset to use config/models.yaml.
# YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/foundationModels/v1

# Required for autonomous run/test/fix loops.
# Executed code still has the OS permissions of the current user; this is not a VM.
AGENT_ALLOW_CODE_EXECUTION=true

# HTTPS research is separately gated by config/agent.yaml domain allow-list.
AGENT_ALLOW_RESEARCH=false
